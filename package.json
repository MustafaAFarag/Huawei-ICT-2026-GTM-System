{
  "name": "revenue-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "infra:up": "docker compose up -d postgres redis mailpit",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @revenue/database generate",
    "db:migrate": "pnpm --filter @revenue/database migrate",
    "db:seed": "pnpm --filter @revenue/api seed",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @revenue/api test",
    "test:e2e": "playwright test",
    "twenty:build": "node scripts/twenty-build.mjs",
    "check:links": "python3 scripts/check_links.py",
    "setup": "node scripts/setup.mjs",
    "check:engines": "tsx scripts/check-engines.ts",
    "check:roles": "tsx scripts/verify-roles.ts",
    "check:performance": "tsx scripts/measure-local.ts",
    "backup:local": "node scripts/backup-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
